---
// src/layouts/BaseLayout.astro
import { brand, seo, client, theme, alert, schemaJson as schema, analytics, hours, gallery, projects, hero } from '../lib/data';
import { generateThemeCSS, generateLayoutCSS } from '../lib/brand';
import { buildFontFaceCSS } from '../lib/fonts';
import { resolveImage } from '../lib/images';
import { isAlertVisible } from '../lib/alert';
// v4 CSS architecture
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/layout.css';
import '../styles/components.css';
import '../styles/atmosphere.css';
import '../styles/animations.css';
// Section CSS now scoped inside each component's <style> tag.
// Only brand-name.css and menu.css kept (shared by multiple components / unchanged).
import '../styles/brand-name.css';
import '../styles/menu.css';
// Legacy CSS removed in Phase 4 — v4 atmosphere.css replaces visual-depth.css,
// accent styles moved to components.css, bg-presets replaced by atmosphere system.
import { ClientRouter } from "astro:transitions";
import TourOverlay from '../components/TourOverlay.astro';
import type { TourData } from '../lib/types';
import { isPreview, getDisclaimerHtml, getNoindexMeta, getPreviewOgTitle, type PreviewData } from '../lib/preview';

// tour.json is optional: preview sites have it, production sites don't.
// Uses import.meta.glob (Vite-native) instead of node:fs — existsSync + import.meta.url
// resolves to a virtual path during Astro build, causing tour markup to silently disappear.
const tourFiles = import.meta.glob<{ default: TourData }>('../data/tour.json', { eager: true });
const tourData: TourData | undefined = Object.values(tourFiles)[0]?.default;

// preview.json is optional: present during preview builds, removed on go-live.
// When present, the fallback disclaimer bar is rendered (visible by default via CSS).
// The proxy overlay CSS hides it with #zm-fallback-disclaimer { display: none !important }.
const previewFiles = import.meta.glob<{ default: PreviewData }>('../data/preview.json', { eager: true });
const previewData: PreviewData | undefined = Object.values(previewFiles)[0]?.default;
const inPreview = isPreview(previewData);

const themeCSS = generateThemeCSS(brand);
const layout = (theme.layout || {}) as Record<string, string>;
const layoutCSS = generateLayoutCSS(layout);
const fontFaceCSS = buildFontFaceCSS(brand);
const schemaJsonStr = JSON.stringify(schema);
const hoursJson = JSON.stringify(hours);
const hasGallery = gallery?.images?.length > 0;
const hasProjects = projects?.projects?.length > 0;

// Alert banner date gating — hide if outside startDate/endDate window
const alertVisible = isAlertVisible(alert);

// Preload hero image for LCP optimization
const heroImage = hero?.heroImage;
const heroResolved = heroImage ? resolveImage(heroImage) : null;

// Structural layout tokens → data attributes on body
const headerStyle = layout.headerStyle || 'glass';
const cardStyle = layout.cardStyle || 'shadow';
const sectionPattern = layout.sectionPattern || 'alternating';
const headerPosition = layout.headerPosition || 'hidden-on-scroll';
const motionIntensity = layout.motionIntensity || 'standard';
const atmosphereLevel = layout.atmosphereLevel || 'minimal';
const heroStyle = layout.heroStyle || 'split';
const dividerStyle = layout.dividerStyle || 'fade';
const buttonVariant = layout.buttonVariant || 'solid';
// Legacy tokens (kept for existing CSS until Phase 2 overhaul)
const bgPreset = layout.backgroundPreset || 'clean';
const depth = layout.depth || '';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{seo.pageTitle || client.name}</title>
  <meta name="description" content={seo.metaDescription || ""}>
  <meta property="og:title" content={inPreview ? getPreviewOgTitle(seo.ogTitle || client.name) : (seo.ogTitle || client.name)}>
  <meta property="og:description" content={seo.ogDescription || ""}>
  {seo.ogImage && <meta property="og:image" content={seo.ogImage} />}
  {seo.canonicalUrl && <link rel="canonical" href={seo.canonicalUrl} />}
  {inPreview && <Fragment set:html={getNoindexMeta()} />}
  <ClientRouter fallback="swap" />
  {heroResolved && <link rel="preload" as="image" type="image/webp" href={heroResolved.src} fetchpriority="high" />}
  <link rel="icon" href="/favicons/favicon.svg" type="image/svg+xml">
  <link rel="icon" href="/favicons/favicon.ico" sizes="32x32">
  <link rel="icon" href="/favicons/favicon-96x96.png" type="image/png" sizes="96x96">
  <link rel="apple-touch-icon" href="/favicons/apple-touch-icon.png">
  <style set:html={fontFaceCSS}></style>
  <style set:html={themeCSS}></style>
  {layoutCSS && <style set:html={layoutCSS}></style>}
  {analytics?.umamiWebsiteId && (
    <script defer src={analytics.umamiScriptUrl} data-website-id={analytics.umamiWebsiteId} />
  )}
</head>
<body
  data-accent={theme.accentStyle || "border"}
  data-header-style={headerStyle}
  data-card-style={cardStyle}
  data-section-pattern={sectionPattern}
  data-header-position={headerPosition}
  data-motion={motionIntensity}
  data-atmosphere={atmosphereLevel}
  data-hero-style={heroStyle}
  data-divider={dividerStyle}
  data-btn-variant={buttonVariant}
  data-bg-preset={bgPreset}
  data-depth={depth || undefined}
>
  {inPreview && previewData && <Fragment set:html={getDisclaimerHtml(previewData)} />}

  {atmosphereLevel !== 'none' && (
    <div class="noise-overlay" aria-hidden="true"></div>
  )}

  {alertVisible && (
    <div class="alert-banner">{alert.text}</div>
  )}

  <slot />

  {schema && (
    <script type="application/ld+json" set:html={schemaJsonStr}></script>
  )}
  <script type="application/json" id="hours-data" set:html={hoursJson}></script>
  <script src="../scripts/animation-controller.ts"></script>
  <script is:inline src="/scripts/open-now.js"></script>
  <script is:inline src="/scripts/menu-scroll.js"></script>
  {hasGallery && (
    <script is:inline src="/scripts/gallery-hint.js"></script>
  )}
  {hasProjects && (
    <script is:inline src="/scripts/gallery-slider.js"></script>
  )}
  <TourOverlay tour={tourData} />
</body>
</html>
