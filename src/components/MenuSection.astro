---
import { menu, client } from '../lib/data';
import OptimizedImg from './OptimizedImg.astro';

const categories = menu?.categories || [];
const hasMenu = categories.length > 0 && categories.some((c) => c.items?.length > 0);
const orderUrl = client.orderUrl || '';
---
{hasMenu && (
  <section class="menu-section section" id="menu">
    <div class="container">
      <h2 class="section-heading">Menu</h2>

      <nav class="menu-nav" aria-label="Menu categories">
        {categories.map((cat, i) => (
          <a href={`#menu-cat-${i}`} class="menu-pill" data-cat-index={i}>
            {cat.name}
          </a>
        ))}
      </nav>

      {categories.map((cat, i) => (
        <div class="menu-category" id={`menu-cat-${i}`}>
          <h3 class="menu-category-name">{cat.name}</h3>
          <div class="menu-items">
            {cat.items.map((item) => (
              <div class={`menu-item ${item.featured ? 'menu-item--featured' : ''}`}>
                {item.featured && item.photo && (
                  <OptimizedImg
                    src={item.photo}
                    alt={item.name}
                    class="menu-item-photo"
                    width={280}
                    height={200}
                  />
                )}
                <div class="menu-item-content">
                  <div class="menu-item-header">
                    <span class="menu-item-name">{item.name}</span>
                    {item.price && item.price !== 'Ask' && (
                      <span class="menu-item-price">{item.price}</span>
                    )}
                    {item.price === 'Ask' && (
                      <span class="menu-item-price menu-item-price--ask">Ask</span>
                    )}
                  </div>
                  {item.description && (
                    <p class="menu-item-desc">{item.description}</p>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      ))}

      {orderUrl && (
        <div class="menu-order-cta">
          <a href={orderUrl} class="btn-primary" target="_blank" rel="noopener">
            Order Online
          </a>
          <p class="menu-order-note">Full menu and online ordering available</p>
        </div>
      )}
    </div>
  </section>
)}

<style>
  /* ── Menu Section ─────────────────────────────────────────────────── */

  .menu-section {
    background: var(--background);
  }

  /* ── Sticky pill nav ──────────────────────────────────────────────── */

  .menu-nav {
    display: flex;
    gap: var(--gap-sm, 0.5rem);
    overflow-x: auto;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
    padding: 0.75rem 0;
    position: sticky;
    top: 3.5rem;
    z-index: 10;
    background: var(--background);
    border-bottom: 1px solid var(--border);
    margin-bottom: var(--gap-md, 1.5rem);
  }

  .menu-nav::-webkit-scrollbar {
    display: none;
  }

  .menu-pill {
    flex-shrink: 0;
    padding: var(--gap-sm, 0.5rem) var(--gap, 1rem);
    border-radius: 999px;
    border: 1px solid var(--border);
    background: var(--surface);
    color: var(--text);
    font-size: var(--small-size, 0.875rem);
    font-weight: 500;
    text-decoration: none;
    white-space: nowrap;
    min-height: var(--touch-min, 44px);
    display: flex;
    align-items: center;
    transition: background var(--duration-fast, 0.2s), border-color var(--duration-fast, 0.2s);
  }

  .menu-pill:hover {
    background: var(--accent);
    color: var(--background);
    text-decoration: none;
  }

  .menu-pill.active {
    background: var(--accent);
    color: var(--background);
    border-color: var(--accent);
  }

  /* ── Category blocks ─────────────────────────────────────────────── */

  .menu-category {
    margin-bottom: var(--gap-lg, 2.5rem);
    scroll-margin-top: 7rem;
  }

  .menu-category-name {
    font-family: var(--font-heading);
    font-size: var(--font-size-h2);
    margin-bottom: var(--gap, 1rem);
    padding-bottom: var(--gap-sm, 0.5rem);
    border-bottom: 2px solid var(--border);
  }

  /* ── Item list ───────────────────────────────────────────────────── */

  .menu-items {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 1rem);
  }

  /* ── Single menu item ────────────────────────────────────────────── */

  .menu-item {
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
  }

  .menu-item:last-child {
    border-bottom: none;
  }

  /* ── Featured item treatment ─────────────────────────────────────── */

  .menu-item--featured {
    border-left: 3px solid var(--accent);
    padding-left: var(--gap, 1rem);
    border-bottom: 1px solid var(--border);
  }

  /* ── Item photo ──────────────────────────────────────────────────── */

  .menu-item-photo {
    width: 100%;
    max-width: 280px;
    height: auto;
    border-radius: var(--card-radius, var(--radius, 12px));
    margin-bottom: var(--gap-sm, 0.5rem);
    object-fit: cover;
    aspect-ratio: 7 / 5;
  }

  /* ── Item content area ───────────────────────────────────────────── */

  .menu-item-content {
    flex: 1;
  }

  .menu-item-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--gap-sm, 0.5rem);
  }

  .menu-item-name {
    font-family: var(--font-heading);
    font-weight: 600;
    font-size: var(--body-size, 1rem);
    color: var(--text);
  }

  .menu-item--featured .menu-item-name {
    font-size: var(--lead-size, 1.1em);
  }

  .menu-item-price {
    font-weight: 500;
    color: var(--textMuted, var(--text));
    white-space: nowrap;
    flex-shrink: 0;
  }

  .menu-item-price--ask {
    font-style: italic;
  }

  .menu-item-desc {
    color: var(--textMuted, var(--text));
    font-size: var(--small-size, 0.875rem);
    margin-top: var(--gap-xs, 0.25rem);
    line-height: var(--line-height-body, 1.4);
  }

  /* ── Order CTA ───────────────────────────────────────────────────── */

  .menu-order-cta {
    text-align: center;
    margin-top: var(--gap-lg, 2rem);
    padding-top: var(--gap-lg, 2rem);
    border-top: 1px solid var(--border);
  }

  .menu-order-note {
    color: var(--textMuted, var(--text));
    font-size: var(--small-size, 0.875rem);
    margin-top: var(--gap-sm, 0.5rem);
  }

  /* ── Desktop: photo beside content ───────────────────────────────── */

  @media (min-width: 640px) {
    .menu-item--featured {
      display: flex;
      gap: var(--gap, 1rem);
      align-items: flex-start;
    }

    .menu-item-photo {
      width: 200px;
      margin-bottom: 0;
      flex-shrink: 0;
    }
  }
</style>
