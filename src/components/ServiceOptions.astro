---
/**
 * ServiceOptions — reusable two-card photo comparison.
 * Used as differentiator variant "service-options".
 * Reads from differentiator.json `options` array.
 * Each option: { title, description, image }
 * Generic: works for Mobile/Shop, Dine-in/Takeout, Residential/Commercial, etc.
 */
import OptimizedImg from './OptimizedImg.astro';

const diffFiles = import.meta.glob('../data/differentiator.json', { eager: true });
const diffData = Object.values(diffFiles)[0] as any;

const heading = diffData?.heading || '';
const options = diffData?.options || [];
---

{options.length > 0 && (
  <section class="section service-options-section" id="differentiator">
    <div class="container">
      {heading && <h2 class="section-heading reveal-up">{heading}</h2>}
      <div class="service-options-grid stagger-parent">
        {options.map((opt: any) => (
          <div class="service-option-card reveal-up">
            {opt.image && (
              <div class="service-option-card__image">
                <OptimizedImg
                  src={opt.image}
                  alt={opt.title}
                  width={800}
                  height={600}
                />
              </div>
            )}
            <div class="service-option-card__body">
              <h3 class="service-option-card__title">{opt.title}</h3>
              {opt.description && <p class="service-option-card__desc">{opt.description}</p>}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .service-options-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--gap-lg, 2rem);
    max-width: 900px;
    margin: 0 auto;
  }

  .service-option-card {
    border-radius: var(--card-radius, var(--radius, 12px));
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-normal, 0.4s) var(--ease-out-expo, ease),
                box-shadow var(--duration-normal, 0.4s) var(--ease-out-expo, ease);
  }

  .service-option-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover, 0 4px 16px rgba(0,0,0,0.15));
  }

  .service-option-card__image {
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .service-option-card__image :global(img),
  .service-option-card__image :global(picture img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .service-option-card:hover .service-option-card__image :global(img),
  .service-option-card:hover .service-option-card__image :global(picture img) {
    transform: scale(1.03);
  }

  .service-option-card__body {
    padding: 1.25rem;
  }

  .service-option-card__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    color: var(--text);
  }

  .service-option-card__desc {
    font-size: 0.9rem;
    line-height: 1.5;
    color: var(--textMuted);
    margin: 0;
  }

  @media (max-width: 640px) {
    .service-options-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .service-option-card {
      transition: none;
    }
    .service-option-card:hover {
      transform: none;
    }
    .service-option-card:hover .service-option-card__image :global(img),
    .service-option-card:hover .service-option-card__image :global(picture img) {
      transform: none;
    }
  }
</style>
