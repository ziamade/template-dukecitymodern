---
// src/components/ProjectGallery.astro
import { projects } from '../lib/data';
import OptimizedImg from './OptimizedImg.astro';

const items = (projects?.projects || []).filter(
  (p) => p.before && p.after
);
const hasProjects = items.length > 0;
---
{hasProjects && (
  <section class="projects-section section" id="projects">
    <div class="container">
      <h2 class="section-heading">Our Work</h2>
      <div class="projects-grid">
        {items.map((project, i) => (
          <div class="project-card">
            <div class="project-slider" data-index={i}>
              <div class="project-slider-wrap">
                <OptimizedImg
                  src={project.after}
                  alt={`${project.title} - after`}
                  class="project-img project-img--after"
                  width={600}
                  height={400}
                />
                <OptimizedImg
                  src={project.before}
                  alt={`${project.title} - before`}
                  class="project-img project-img--before"
                  width={600}
                  height={400}
                />
                <div class="project-slider-handle" aria-label="Drag to compare before and after" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
                  <div class="project-slider-line"></div>
                  <div class="project-slider-knob">
                    <span class="project-slider-arrows">&lsaquo; &rsaquo;</span>
                  </div>
                </div>
              </div>
              <div class="project-slider-labels">
                <span class="project-label project-label--before">Before</span>
                <span class="project-label project-label--after">After</span>
              </div>
            </div>
            <div class="project-info">
              <h3 class="project-title">{project.title}</h3>
              {project.service && (
                <span class="project-service-tag">{project.service}</span>
              )}
              {project.description && (
                <p class="project-desc">{project.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  /* ── Section ────────────────────────────────────────────────────── */
  .projects-section {
    padding: var(--section-gap) 0;
  }

  /* ── Grid ────────────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg, 2rem);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Card ────────────────────────────────────────────────────────── */
  .project-card {
    background: var(--surface);
    border-radius: var(--card-radius, var(--radius, 12px));
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-normal, 0.4s) var(--ease-out-expo, ease),
                box-shadow var(--duration-normal, 0.4s) var(--ease-out-expo, ease);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  /* ── Slider container ───────────────────────────────────────────── */
  .project-slider-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    cursor: col-resize;
    background: var(--surface);
  }

  /* ── Images: stacked via absolute positioning ───────────────────── */
  .project-slider-wrap :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project-slider-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Before image sits on top and is clipped by JS */
  .project-slider-wrap :global(.project-img--before) {
    z-index: 1;
    clip-path: inset(0 50% 0 0);
  }

  .project-slider-wrap :global(.project-img--after) {
    z-index: 0;
  }

  /* ── Slider handle ──────────────────────────────────────────────── */
  .project-slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    margin-left: -2px;
    z-index: 3;
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .project-slider-handle:focus-visible .project-slider-knob {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .project-slider-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .project-slider-knob {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg, #fff);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform var(--duration-fast) ease;
  }

  .project-slider-handle:hover .project-slider-knob {
    transform: scale(1.1);
  }

  .project-slider-arrows {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    line-height: 1;
  }

  /* ── Labels ─────────────────────────────────────────────────────── */
  .project-slider-labels {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
  }

  .project-label {
    font-size: var(--caption-size, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--textMuted, var(--text));
  }

  /* ── Project info ───────────────────────────────────────────────── */
  .project-info {
    padding: 1rem 1.25rem 1.25rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.375rem;
  }

  .project-service-tag {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    font-size: var(--caption-size, 0.75rem);
    font-weight: 600;
    border-radius: var(--radius-full, 9999px);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    margin-bottom: 0.5rem;
  }

  .project-desc {
    font-size: var(--small-size, 0.875rem);
    color: var(--textMuted, var(--text));
    line-height: 1.5;
    margin: 0.5rem 0 0;
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .project-slider-knob {
      width: 30px;
      height: 30px;
    }

    .project-slider-arrows {
      font-size: 0.875rem;
    }
  }

  /* ── Reduced motion ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-slider-knob {
      transition: none;
    }
  }
</style>
