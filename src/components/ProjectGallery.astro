---
// src/components/ProjectGallery.astro
import { projects } from '../lib/data';
import OptimizedImg from './OptimizedImg.astro';

interface Props { variant?: string | number; }
const { variant: variantProp } = Astro.props;
const variantStr = String(variantProp || 'grid');

const items = (projects?.projects || []).filter(
  (p) => p.before && p.after
);
const hasProjects = items.length > 0;
---
{hasProjects && (
  <section class="projects-section section" id="projects">
    <div class="container">
      <h2 class="section-heading">Our Work</h2>
      
      {/* -- Carousel variant ------------------------------------------- */}
      {variantStr === 'carousel' && (
        <div class="projects-carousel" data-carousel tabindex="0" role="region" aria-roledescription="carousel" aria-label="Project showcase">
          <div class="projects-carousel__track">
            {items.map((project, i) => (
              <div class={`projects-carousel__slide ${i === 0 ? 'projects-carousel__slide--active' : ''}`} data-slide={i} aria-hidden={i !== 0 ? 'true' : undefined}>
                <div class="project-slider" data-index={i}>
                  <div class="project-slider-wrap">
                    <OptimizedImg
                      src={project.after}
                      alt={`${project.title} - after`}
                      class="project-img project-img--after"
                      width={900}
                      height={600}
                    />
                    <OptimizedImg
                      src={project.before}
                      alt={`${project.title} - before`}
                      class="project-img project-img--before"
                      width={900}
                      height={600}
                    />
                    <div class="project-slider-handle" aria-label="Drag to compare before and after" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
                      <div class="project-slider-line"></div>
                      <div class="project-slider-knob">
                        <span class="project-slider-arrows">&lsaquo; &rsaquo;</span>
                      </div>
                    </div>
                  </div>
                  <div class="project-slider-labels">
                    <span class="project-label project-label--before">Before</span>
                    <span class="project-label project-label--after">After</span>
                  </div>
                </div>
                <div class="projects-carousel__info">
                  {project.service && <span class="projects-carousel__tag">{project.service}</span>}
                  {project.title && <h3 class="projects-carousel__title">{project.title}</h3>}
                  {project.description && <p class="projects-carousel__desc">{project.description}</p>}
                </div>
              </div>
            ))}
          </div>

          {items.length > 1 && (
            <>
              <button class="projects-carousel__nav projects-carousel__nav--prev" aria-label="Previous project" data-prev>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M15 18l-6-6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <button class="projects-carousel__nav projects-carousel__nav--next" aria-label="Next project" data-next>
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M9 18l6-6-6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </button>
              <div class="projects-carousel__dots" role="tablist" aria-label="Project navigation">
                {items.map((_, i) => (
                  <button class={`projects-carousel__dot ${i === 0 ? 'active' : ''}`} role="tab" aria-selected={i === 0 ? 'true' : 'false'} aria-label={`Project ${i + 1}`} data-dot={i} />
                ))}
              </div>
            </>
          )}
        </div>
      )}

      {/* -- Grid variant (default) ------------------------------------- */}
      {variantStr !== 'carousel' && (
      <div class="projects-grid">
        {items.map((project, i) => (
          <div class="project-card">
            <div class="project-slider" data-index={i}>
              <div class="project-slider-wrap">
                <OptimizedImg
                  src={project.after}
                  alt={`${project.title} - after`}
                  class="project-img project-img--after"
                  width={600}
                  height={400}
                />
                <OptimizedImg
                  src={project.before}
                  alt={`${project.title} - before`}
                  class="project-img project-img--before"
                  width={600}
                  height={400}
                />
                <div class="project-slider-handle" aria-label="Drag to compare before and after" role="slider" aria-valuemin="0" aria-valuemax="100" aria-valuenow="50" tabindex="0">
                  <div class="project-slider-line"></div>
                  <div class="project-slider-knob">
                    <span class="project-slider-arrows">&lsaquo; &rsaquo;</span>
                  </div>
                </div>
              </div>
              <div class="project-slider-labels">
                <span class="project-label project-label--before">Before</span>
                <span class="project-label project-label--after">After</span>
              </div>
            </div>
            <div class="project-info">
              <h3 class="project-title">{project.title}</h3>
              {project.service && (
                <span class="project-service-tag">{project.service}</span>
              )}
              {project.description && (
                <p class="project-desc">{project.description}</p>
              )}
            </div>
          </div>
        ))}
      </div>
      )}
    </div>
  </section>
)}

<style>
  /* ── Section ────────────────────────────────────────────────────── */
  .projects-section {
    padding: var(--section-gap) 0;
  }

  /* ── Grid ────────────────────────────────────────────────────────── */
  .projects-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-lg, 2rem);
  }

  @media (min-width: 768px) {
    .projects-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  /* ── Card ────────────────────────────────────────────────────────── */
  .project-card {
    background: var(--surface);
    border-radius: var(--card-radius, var(--radius, 12px));
    overflow: hidden;
    border: 1px solid var(--border);
    box-shadow: var(--shadow-card);
    transition: transform var(--duration-normal, 0.4s) var(--ease-out-expo, ease),
                box-shadow var(--duration-normal, 0.4s) var(--ease-out-expo, ease);
  }

  .project-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card-hover);
  }

  /* ── Slider container ───────────────────────────────────────────── */
  .project-slider-wrap {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    cursor: col-resize;
    background: var(--surface);
  }

  /* ── Images: stacked via absolute positioning ───────────────────── */
  .project-slider-wrap :global(picture) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .project-slider-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Before image sits on top and is clipped by JS */
  .project-slider-wrap :global(.project-img--before) {
    z-index: 1;
    clip-path: inset(0 50% 0 0);
  }

  .project-slider-wrap :global(.project-img--after) {
    z-index: 0;
  }

  /* ── Slider handle ──────────────────────────────────────────────── */
  .project-slider-handle {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 4px;
    margin-left: -2px;
    z-index: 3;
    cursor: col-resize;
    display: flex;
    align-items: center;
    justify-content: center;
    outline: none;
  }

  .project-slider-handle:focus-visible .project-slider-knob {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .project-slider-line {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    margin-left: -1px;
    background: var(--accent);
    box-shadow: 0 0 8px color-mix(in srgb, var(--accent) 40%, transparent);
  }

  .project-slider-knob {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--bg, #fff);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
    transition: transform var(--duration-fast) ease;
  }

  .project-slider-handle:hover .project-slider-knob {
    transform: scale(1.1);
  }

  .project-slider-arrows {
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.25em;
    line-height: 1;
  }

  /* ── Labels ─────────────────────────────────────────────────────── */
  .project-slider-labels {
    display: flex;
    justify-content: space-between;
    padding: 0.5rem 0.75rem;
  }

  .project-label {
    font-size: var(--caption-size, 0.75rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--textMuted, var(--text));
  }

  /* ── Project info ───────────────────────────────────────────────── */
  .project-info {
    padding: 1rem 1.25rem 1.25rem;
  }

  .project-title {
    font-family: var(--font-heading);
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text);
    margin: 0 0 0.375rem;
  }

  .project-service-tag {
    display: inline-block;
    padding: 0.2rem 0.625rem;
    font-size: var(--caption-size, 0.75rem);
    font-weight: 600;
    border-radius: var(--radius-full, 9999px);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    color: var(--accent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    margin-bottom: 0.5rem;
  }

  .project-desc {
    font-size: var(--small-size, 0.875rem);
    color: var(--textMuted, var(--text));
    line-height: 1.5;
    margin: 0.5rem 0 0;
  }


  /* -- Carousel variant ---------------------------------------------- */
  .projects-carousel {
    position: relative;
    max-width: 900px;
    margin: 0 auto;
  }

  .projects-carousel__track {
    position: relative;
    overflow: hidden;
  }

  .projects-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.4s ease;
  }

  .projects-carousel__slide--active {
    position: relative;
    opacity: 1;
    pointer-events: auto;
  }

  .projects-carousel__slide .project-slider-wrap {
    aspect-ratio: 16 / 10;
    border-radius: var(--card-radius, var(--radius, 12px));
    overflow: hidden;
  }

  .projects-carousel__info {
    text-align: center;
    padding: 1.25rem 0 0;
  }

  .projects-carousel__tag {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--accent);
    margin-bottom: 0.5rem;
    padding: 0.2rem 0.625rem;
    border-radius: var(--radius-full, 9999px);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
  }

  .projects-carousel__title {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    margin: 0.5rem 0 0.25rem;
    color: var(--text);
  }

  .projects-carousel__desc {
    font-size: 0.9rem;
    color: var(--textMuted);
    margin: 0;
  }

  .projects-carousel__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-100%);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 50%;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: var(--text);
    transition: all 0.2s ease;
    z-index: 2;
  }

  .projects-carousel__nav:hover {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  .projects-carousel__nav:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  .projects-carousel__nav--prev { left: -56px; }
  .projects-carousel__nav--next { right: -56px; }

  .projects-carousel__dots {
    display: flex;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1.25rem;
  }

  .projects-carousel__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 2px solid var(--border);
    background: transparent;
    cursor: pointer;
    padding: 0;
    transition: all 0.2s ease;
  }

  .projects-carousel__dot.active {
    background: var(--accent);
    border-color: var(--accent);
  }

  .projects-carousel__dot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (max-width: 1024px) {
    .projects-carousel__nav--prev { left: 0.5rem; }
    .projects-carousel__nav--next { right: 0.5rem; }
    .projects-carousel__nav {
      background: color-mix(in srgb, var(--surface) 90%, transparent);
      backdrop-filter: blur(4px);
    }
  }

  /* ── Responsive ─────────────────────────────────────────────────── */
  @media (max-width: 767px) {
    .project-slider-knob {
      width: 30px;
      height: 30px;
    }

    .project-slider-arrows {
      font-size: 0.875rem;
    }
  }

  /* ── Reduced motion ─────────────────────────────────────────────── */
  @media (prefers-reduced-motion: reduce) {
    .project-card {
      transition: none;
    }

    .project-slider-knob {
      transition: none;
    }

    .projects-carousel__slide {
      transition: none;
    }
  }
</style>

<script>
  function initProjectCarousel() {
    const carousel = document.querySelector('[data-carousel]');
    if (!carousel) return;

    const slides = carousel.querySelectorAll<HTMLElement>('[data-slide]');
    const dots = carousel.querySelectorAll<HTMLElement>('[data-dot]');
    const prevBtn = carousel.querySelector<HTMLButtonElement>('[data-prev]');
    const nextBtn = carousel.querySelector<HTMLButtonElement>('[data-next]');
    let current = 0;

    function goTo(index: number) {
      slides[current].classList.remove('projects-carousel__slide--active');
      slides[current].setAttribute('aria-hidden', 'true');
      dots[current]?.classList.remove('active');
      dots[current]?.setAttribute('aria-selected', 'false');

      current = (index + slides.length) % slides.length;

      slides[current].classList.add('projects-carousel__slide--active');
      slides[current].removeAttribute('aria-hidden');
      dots[current]?.classList.add('active');
      dots[current]?.setAttribute('aria-selected', 'true');
    }

    prevBtn?.addEventListener('click', () => goTo(current - 1));
    nextBtn?.addEventListener('click', () => goTo(current + 1));
    dots.forEach((dot, i) => dot.addEventListener('click', () => goTo(i)));

    // Touch swipe navigation
    let touchStartX = 0;
    let touchStartY = 0;

    carousel.addEventListener('touchstart', (e: TouchEvent) => {
      touchStartX = e.touches[0].clientX;
      touchStartY = e.touches[0].clientY;
    }, { passive: true });

    carousel.addEventListener('touchend', (e: TouchEvent) => {
      const deltaX = e.changedTouches[0].clientX - touchStartX;
      const deltaY = e.changedTouches[0].clientY - touchStartY;
      if (Math.abs(deltaX) > 50 && Math.abs(deltaX) > Math.abs(deltaY)) {
        if (deltaX < 0) goTo(current + 1);
        else goTo(current - 1);
      }
    }, { passive: true });

    // Keyboard navigation (arrow keys when carousel focused)
    carousel.addEventListener('keydown', (e: KeyboardEvent) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); goTo(current - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); goTo(current + 1); }
    });
  }

  document.addEventListener('astro:page-load', initProjectCarousel);
</script>
