---
/**
 * Facility — showcases the business's physical space.
 * Pulls images with category "facility" from gallery.json.
 * Only renders if 3+ facility photos exist.
 */
import { gallery, theme } from '../lib/data';
import OptimizedImg from './OptimizedImg.astro';

const facilityImages = (gallery?.images || []).filter(
  (img: any) => img.category === 'facility'
);

const facilitySection = theme?.sections?.find((s: any) => s.id === 'facility');
const heading = (facilitySection as any)?.heading || 'Our Shop';
---

{facilityImages.length >= 3 && (
  <section class="section facility-section" id="facility">
    <div class="container">
      <h2 class="section-heading reveal-up">{heading}</h2>
      <div class="facility-scroll-wrap">
        <div class="facility-grid stagger-parent">
          {facilityImages.map((img: any) => (
            <div class="facility-card reveal-up">
              <OptimizedImg
                src={img.url || img.image || ''}
                alt={img.alt || 'Our facility'}
                width={800}
                height={600}
              />
            </div>
          ))}
        </div>
        <div class="facility-fade" aria-hidden="true"></div>
      </div>
    </div>
  </section>
)}

<style>
  .facility-grid {
    display: flex;
    gap: var(--gap, 1rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  .facility-grid::-webkit-scrollbar {
    display: none;
  }

  .facility-scroll-wrap {
    position: relative;
  }

  .facility-fade {
    position: absolute;
    top: 0;
    right: 0;
    bottom: 0.5rem;
    width: 60px;
    background: linear-gradient(to left, var(--background, #000) 0%, transparent 100%);
    pointer-events: none;
    z-index: 1;
    transition: opacity 0.3s ease;
  }

  .facility-scroll-wrap.scrolled-end .facility-fade {
    opacity: 0;
  }

  .facility-card {
    flex: 0 0 auto;
    width: min(360px, 75vw);
    border-radius: var(--card-radius, var(--radius, 12px));
    overflow: hidden;
    aspect-ratio: 4 / 3;
    box-shadow: var(--shadow-card);
    scroll-snap-align: start;
    scroll-snap-stop: always;
  }

  .facility-card :global(img),
  .facility-card :global(picture img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s ease;
  }

  .facility-card:hover :global(img),
  .facility-card:hover :global(picture img) {
    transform: scale(1.03);
  }

  @media (max-width: 480px) {
    .facility-card {
      width: 85vw;
    }
    .facility-fade {
      width: 40px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .facility-card :global(img),
    .facility-card :global(picture img) {
      transition: none;
    }
    .facility-card:hover :global(img),
    .facility-card:hover :global(picture img) {
      transform: none;
    }
  }
</style>

<script>
  function initFacilityScroll() {
    const wraps = document.querySelectorAll('.facility-scroll-wrap');
    wraps.forEach(wrap => {
      const scroll = wrap.querySelector('.facility-grid');
      if (!scroll) return;
      function checkScroll() {
        const atEnd = scroll!.scrollLeft + scroll!.clientWidth >= scroll!.scrollWidth - 10;
        wrap.classList.toggle('scrolled-end', atEnd);
      }
      scroll.addEventListener('scroll', checkScroll, { passive: true });
      checkScroll();
    });
  }

  document.addEventListener('astro:page-load', initFacilityScroll);
</script>
