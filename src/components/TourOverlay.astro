---
// src/components/TourOverlay.astro
// Cinematic intro + Driver.js guided tour for preview sites.
// Only renders when tour.json exists (preview builds only).
import type { TourData } from '../lib/types';

interface Props {
  tour?: TourData;
}

const { tour } = Astro.props;
---

{tour && tour.steps.length > 0 && (
  <link rel="stylesheet" href="/styles/driver.css" />
  <link rel="stylesheet" href="/styles/tour-theme.css" />

  <div id="tour-overlay" data-tour-config={JSON.stringify(tour)}>
    {/* Cinematic intro overlay */}
    <div id="tour-intro" class="tour-intro" role="dialog" aria-modal="true">
      <div class="tour-intro__content">
        <p class="tour-intro__label">ZiaMade</p>
        <h2 class="tour-intro__heading">Let's walk through your new site</h2>
        <p class="tour-intro__sub">We researched your business, studied your competition, and built this for you. Here's what went into it.</p>
        <div class="tour-intro__actions">
          <button id="tour-start" class="tour-intro__start">Start Tour</button>
          <button id="tour-skip" class="tour-intro__skip">Skip</button>
        </div>
      </div>
    </div>

    {/* Floating trigger button (visible after intro dismissed) */}
    <button
      id="tour-trigger"
      class="tour-trigger"
      aria-label="Tour this site"
      style="display:none"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
      <span class="tour-trigger__label">Tour this site</span>
    </button>
  </div>
)}

<script is:inline>
  (function() {
    var container = document.getElementById('tour-overlay');
    if (!container) return;

    var config = JSON.parse(container.dataset.tourConfig);
    var intro = document.getElementById('tour-intro');
    var triggerBtn = document.getElementById('tour-trigger');

    // Filter steps to only those whose target elements exist in the DOM
    var validSteps = config.steps.filter(function(step) {
      return document.querySelector(step.target) !== null;
    });
    if (validSteps.length === 0) {
      if (intro) intro.style.display = 'none';
      return;
    }

    function initTour() {
      // Driver.js is copied to public/scripts/ at install time
      // (is:inline scripts can't use bare imports or node_modules paths)
      import('/scripts/driver.js.mjs').then(function(mod) {
        var driverJs = mod.driver;

        // Pause Lenis smooth scroll during tour
        var lenis = window.__lenis;

        var d = driverJs({
          showProgress: true,
          smoothScroll: false,
          showButtons: ['next', 'previous', 'close'],
          steps: validSteps.map(function(step) {
            return {
              element: step.target,
              popover: {
                title: step.title,
                description: step.body,
                side: 'bottom',
                align: 'center',
              },
            };
          }),
          onHighlightStarted: function() {
            if (lenis) lenis.stop();
          },
          onDestroyed: function() {
            if (lenis) lenis.start();
            localStorage.setItem('tour-seen', 'true');
            if (triggerBtn) triggerBtn.style.display = '';
          },
        });

        d.drive();
      }).catch(function(err) {
        console.warn('[tour] Failed to load driver.js:', err);
        if (intro) intro.style.display = 'none';
        if (triggerBtn) triggerBtn.style.display = '';
      });
    }

    // Cinematic intro logic
    var shouldAutoload = (function() {
      var params = new URLSearchParams(window.location.search);
      var hasTourParam = params.has('tour') || params.get('utm_content') === 'tour';
      var alreadySeen = localStorage.getItem('tour-seen') === 'true';
      return hasTourParam && !alreadySeen;
    })();

    if (shouldAutoload && intro) {
      intro.style.display = 'flex';
      document.getElementById('tour-start').addEventListener('click', function() {
        intro.classList.add('tour-intro--fade-out');
        setTimeout(function() {
          intro.style.display = 'none';
          initTour();
        }, 400);
      });
      document.getElementById('tour-skip').addEventListener('click', function() {
        intro.style.display = 'none';
        localStorage.setItem('tour-seen', 'true');
        if (triggerBtn) triggerBtn.style.display = '';
      });
      document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape' && intro.style.display !== 'none') {
          intro.style.display = 'none';
          localStorage.setItem('tour-seen', 'true');
          if (triggerBtn) triggerBtn.style.display = '';
        }
      });
    } else {
      if (intro) intro.style.display = 'none';
      if (triggerBtn) triggerBtn.style.display = '';
      if (triggerBtn) triggerBtn.addEventListener('click', function() {
        initTour();
        triggerBtn.style.display = 'none';
      });
    }
  })();
</script>

<style>
  #tour-overlay {
    position: fixed;
    z-index: 0;
    pointer-events: none;
  }

  .tour-intro {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: none;
    align-items: center;
    justify-content: center;
    background: rgba(13, 17, 23, 0.92);
    animation: tourFadeIn 0.6s ease;
    pointer-events: auto;
  }

  .tour-intro--fade-out {
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  .tour-intro__content {
    text-align: center;
    max-width: 480px;
    padding: 2rem;
  }

  .tour-intro__label {
    font-family: var(--font-heading, 'Clash Display', sans-serif);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--brand-accent, #2ec4b6);
    margin-bottom: 1rem;
  }

  .tour-intro__heading {
    font-family: var(--font-heading, 'Clash Display', sans-serif);
    font-size: clamp(1.5rem, 4vw, 2rem);
    font-weight: 700;
    color: var(--brand-text, #f5f0e8);
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .tour-intro__sub {
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: 1rem;
    color: var(--brand-text-muted, #e8d5b7);
    line-height: 1.6;
    margin-bottom: 2rem;
  }

  .tour-intro__actions {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.5rem;
  }

  .tour-intro__start {
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: 1rem;
    font-weight: 600;
    padding: 0.75rem 2rem;
    background: var(--brand-accent, #2ec4b6);
    color: var(--brand-bg, #0d1117);
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.2s;
  }

  .tour-intro__start:hover { opacity: 0.85; }

  .tour-intro__skip {
    font-family: var(--font-body, 'Space Grotesk', sans-serif);
    font-size: 0.875rem;
    color: var(--brand-text-muted, #e8d5b7);
    background: none;
    border: none;
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .tour-trigger {
    position: fixed;
    bottom: 5.5rem;
    right: 1.25rem;
    z-index: 899;
    pointer-events: auto;
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.625rem 1rem;
    background: var(--brand-surface, #161b22);
    border: 1px solid var(--brand-border, rgba(255,255,255,0.08));
    border-radius: 999px;
    color: var(--brand-text, #f5f0e8);
    font-family: var(--font-body, sans-serif);
    font-size: 0.8125rem;
    font-weight: 500;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s;
    box-shadow: 0 2px 12px rgba(0,0,0,0.3);
  }

  .tour-trigger:hover {
    background: var(--brand-surface-alt, #1c2128);
    border-color: var(--brand-accent, #2ec4b6);
  }

  .tour-trigger svg {
    color: var(--brand-accent, #2ec4b6);
  }

  @media (max-width: 640px) {
    .tour-trigger__label { display: none; }
    .tour-trigger { padding: 0.75rem; bottom: 5rem; }
  }

  @keyframes tourFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
