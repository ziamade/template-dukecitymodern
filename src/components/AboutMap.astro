---
// src/components/AboutMap.astro
import { client, location, about, brand } from '../lib/data';
import BrandName from './BrandName.astro';
import OptimizedImg from './OptimizedImg.astro';
import { brandify } from '../lib/brandify';

const logoUrl = client.logoUrl || '';
const aboutImage = about.image || '';
const address = [location.address, location.city, location.state, location.zip].filter(Boolean).join(', ');
const headingText = about.heading || 'About';
const headingHasName = client.name && headingText.toLowerCase().includes(client.name.toLowerCase());
---
<section class="about-section section" id="about">
  <div class="container about-grid">
    {about?.text && (
      <div class="about-text">
        <h2>{headingText}{!headingHasName && <>{' '}<BrandName size="inline" /></>}</h2>
        <p class="about-text-content" set:html={brandify(about.text, client.name, brand)} />
      </div>
    )}
    <div class="about-sidebar">
      {aboutImage && (
        <div class="about-portrait">
          <OptimizedImg
            src={aboutImage}
            alt={client.name}
            class="about-portrait-img"
            width={320}
            height={320}
          />
        </div>
      )}
      {!aboutImage && logoUrl && (
        <div class="about-logo">
          <OptimizedImg
            src={logoUrl}
            alt={client.name}
            class="about-logo-img"
            width={240}
            height={180}
          />
        </div>
      )}
      {!aboutImage && !logoUrl && (
        <div class="about-placeholder" aria-hidden="true">
          <span class="about-placeholder-initials">{client.name?.split(' ').map((w: string) => w[0]).join('').slice(0, 2).toUpperCase() || '?'}</span>
        </div>
      )}
      <div class="about-map">
        <p class="about-address">{location.address || ''}<br />{location.city || ''}, {location.state || ''} {location.zip || ''}</p>
        {location.mapLink && (
          <a href={location.mapLink} class="btn btn--primary btn--sm about-directions-btn" target="_blank" rel="noopener">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
            Get Directions
          </a>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding-block: var(--section-pad, 4rem);
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap-xl, 3rem);
    align-items: start;
  }

  .about-text h2 {
    margin-bottom: 1rem;
  }

  .about-text-content {
    line-height: 1.7;
    color: var(--textMuted, var(--text));
    max-width: 65ch;
  }

  .about-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .about-portrait {
    display: flex;
    justify-content: center;
  }

  .about-portrait-img,
  .about-portrait picture img {
    width: 200px;
    height: 200px;
    object-fit: cover;
    border-radius: 50%;
  }

  .about-logo {
    display: flex;
    justify-content: center;
  }

  .about-logo-img,
  .about-logo picture img {
    max-width: 180px;
    height: auto;
    object-fit: contain;
  }

  .about-map {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .about-address {
    font-size: 0.9rem;
    color: var(--textMuted, var(--text));
    line-height: 1.5;
  }

  .about-directions-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    width: fit-content;
  }

  .about-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 200px;
    height: 200px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), color-mix(in oklch, var(--accent) 70%, var(--bg)));
    margin: 0 auto;
  }

  .about-placeholder-initials {
    font-family: var(--font-heading);
    font-size: var(--display-size, 3rem);
    font-weight: 700;
    color: var(--bg, var(--background));
    line-height: 1;
  }

  @media (max-width: 767px) {
    .about-grid {
      grid-template-columns: 1fr;
      gap: var(--gap-lg, 2rem);
    }
  }
</style>