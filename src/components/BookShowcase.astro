---
// src/components/BookShowcase.astro
// Showcases a book with cover images, description, purchase links, and format badges.
// Reads from src/data/book.json. Designed for author/publisher sites.
import { book } from '../lib/data';
import OptimizedImg from './OptimizedImg.astro';

const title = book?.title || '';
const subtitle = book?.subtitle || '';
const description = book?.description || '';
const coverImage = book?.coverImage || '';
const backCoverImage = book?.backCoverImage || '';
const purchaseUrl = book?.purchaseUrl || '';
const purchaseLabel = book?.purchaseLabel || 'Order Now';
const formats = book?.formats || [];
const publishDate = book?.publishDate || '';
const publisher = book?.publisher || '';
const blurb = book?.blurb || '';

const hasBook = !!(title && (coverImage || description));

interface Props { variant?: string | number; }
---
{hasBook && (
  <section class="book-section section" id="book">
    <div class="container">
      <div class="book-layout">
        {/* Cover images */}
        <div class="book-covers reveal-scale">
          {coverImage && (
            <div class="book-cover book-cover--front">
              <OptimizedImg
                src={coverImage}
                alt={`${title} front cover`}
                width={435}
                height={645}
                loading="lazy"
              />
            </div>
          )}
          {backCoverImage && (
            <div class="book-cover book-cover--back">
              <OptimizedImg
                src={backCoverImage}
                alt={`${title} back cover`}
                width={418}
                height={650}
                loading="lazy"
              />
            </div>
          )}
        </div>

        {/* Book details */}
        <div class="book-details reveal-up">
          {subtitle && <span class="book-eyebrow">{subtitle}</span>}
          <h2 class="book-title">{title}</h2>

          {blurb && (
            <blockquote class="book-blurb">
              <p>{blurb}</p>
            </blockquote>
          )}

          {description && (
            <p class="book-description">{description}</p>
          )}

          {/* Format badges */}
          {formats.length > 0 && (
            <div class="book-formats">
              {formats.map((fmt: string) => (
                <span class="book-format-badge">{fmt}</span>
              ))}
            </div>
          )}

          {/* Publish info */}
          {(publishDate || publisher) && (
            <p class="book-meta">
              {publishDate && <span>Published {publishDate}</span>}
              {publishDate && publisher && <span class="book-meta-sep" aria-hidden="true">&middot;</span>}
              {publisher && <span>{publisher}</span>}
            </p>
          )}

          {/* Purchase CTA */}
          {purchaseUrl && (
            <div class="book-cta">
              <a href={purchaseUrl} class="btn btn--primary" target="_blank" rel="noopener" data-umami-event="book-purchase-click">
                {purchaseLabel}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/><polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/></svg>
              </a>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>
)}

<style>
  /* ── Book Section ───────────────────────────────────────────────── */

  .book-section {
    background: var(--background);
  }

  .book-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--gap-xl, 3rem);
    align-items: center;
  }

  @media (min-width: 768px) {
    .book-layout {
      grid-template-columns: 1fr 1fr;
      gap: clamp(2rem, 4vw, 5rem);
    }
  }

  /* ── Cover images ──────────────────────────────────────────────── */

  .book-covers {
    display: flex;
    justify-content: center;
    gap: var(--gap-md, 1.5rem);
    perspective: 1200px;
  }

  .book-cover {
    border-radius: var(--radius, 12px);
    overflow: hidden;
    box-shadow:
      8px 12px 24px rgba(0, 0, 0, 0.2),
      0 0 0 1px color-mix(in srgb, var(--accent) 10%, transparent);
    transition: transform var(--duration-normal, 0.4s) var(--ease-out-expo);
  }

  .book-cover:hover {
    transform: translateY(-6px) rotateY(-2deg);
  }

  .book-cover :global(img),
  .book-cover :global(picture img) {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0;
  }

  .book-cover--front {
    max-width: 260px;
    z-index: 2;
  }

  .book-cover--back {
    max-width: 240px;
    margin-top: 1.5rem;
    opacity: 0.85;
  }

  @media (max-width: 767px) {
    .book-cover--front {
      max-width: 200px;
    }
    .book-cover--back {
      max-width: 180px;
      margin-top: 1rem;
    }
  }

  /* ── Book details ──────────────────────────────────────────────── */

  .book-details {
    display: flex;
    flex-direction: column;
    gap: var(--gap, 1rem);
  }

  .book-eyebrow {
    font-size: var(--caption-size, 0.75rem);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: var(--tracking-wide, 0.08em);
    text-transform: uppercase;
  }

  .book-title {
    font-family: var(--font-heading);
    font-size: var(--hero-size, clamp(2rem, 1.5rem + 3vw, 3.5rem));
    font-weight: 700;
    line-height: var(--line-height-tight, 1.1);
    letter-spacing: var(--tracking-tight, -0.02em);
    color: var(--text);
  }

  .book-title::after {
    content: '';
    display: block;
    width: 60px;
    height: 3px;
    background: var(--accent);
    border-radius: 2px;
    margin-top: 0.75rem;
  }

  /* ── Blurb (pull quote) ────────────────────────────────────────── */

  .book-blurb {
    border-left: 3px solid var(--accent);
    padding-left: var(--gap-md, 1.5rem);
    margin: 0;
  }

  .book-blurb p {
    font-size: var(--lead-size, clamp(1.125rem, 1rem + 0.5vw, 1.375rem));
    line-height: var(--line-height-body, 1.6);
    color: var(--textMuted, var(--text));
    font-style: italic;
  }

  /* ── Description ───────────────────────────────────────────────── */

  .book-description {
    font-size: 1rem;
    line-height: var(--line-height-body, 1.6);
    color: var(--textMuted, var(--text));
    max-width: 55ch;
  }

  /* ── Format badges ─────────────────────────────────────────────── */

  .book-formats {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .book-format-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
    border-radius: var(--radius-full, 9999px);
    font-size: var(--small-size, 0.875rem);
    font-weight: 600;
    color: var(--accent);
    letter-spacing: 0.02em;
  }

  /* ── Publish metadata ──────────────────────────────────────────── */

  .book-meta {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--small-size, 0.875rem);
    color: var(--textMuted, var(--text));
  }

  .book-meta-sep {
    opacity: 0.4;
  }

  /* ── Purchase CTA ──────────────────────────────────────────────── */

  .book-cta {
    padding-top: 0.5rem;
  }

  .book-cta .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .book-cta .btn svg {
    opacity: 0.7;
    transition: transform var(--duration-fast, 0.2s) ease;
  }

  .book-cta .btn:hover svg {
    transform: translate(2px, -2px);
  }

  /* ── Responsive ────────────────────────────────────────────────── */

  @media (max-width: 767px) {
    .book-layout {
      text-align: center;
    }

    .book-details {
      align-items: center;
    }

    .book-title::after {
      margin-left: auto;
      margin-right: auto;
    }

    .book-blurb {
      border-left: none;
      border-top: 3px solid var(--accent);
      padding-left: 0;
      padding-top: var(--gap, 1rem);
    }

    .book-formats {
      justify-content: center;
    }

    .book-meta {
      justify-content: center;
    }

    .book-cta {
      display: flex;
      justify-content: center;
    }
  }

  /* ── Reduced motion ────────────────────────────────────────────── */

  @media (prefers-reduced-motion: reduce) {
    .book-cover {
      transition: none;
    }
    .book-cover:hover {
      transform: none;
    }
    .book-cta .btn svg {
      transition: none;
    }
  }
</style>
