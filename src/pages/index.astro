---
// src/pages/index.astro
// Data-driven section rendering — no industry detection.
// All layout decisions come from theme.json (set by pipeline or agent skills).
import BaseLayout from '../layouts/BaseLayout.astro';
import StickyHeader from '../components/StickyHeader.astro';
import Hero from '../components/Hero.astro';
import ServiceCards from '../components/ServiceCards.astro';
import PhotoGallery from '../components/PhotoGallery.astro';
import ProjectGallery from '../components/ProjectGallery.astro';
import TrustBar from '../components/TrustBar.astro';
import TrustStats from '../components/TrustStats.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import MenuSection from '../components/MenuSection.astro';
import Reviews from '../components/Reviews.astro';
import FAQ from '../components/FAQ.astro';
import QuoteForm from '../components/QuoteForm.astro';
import OrderVisit from '../components/OrderVisit.astro';
import AboutMap from '../components/AboutMap.astro';
import HoursDisplay from '../components/HoursDisplay.astro';
import Footer from '../components/Footer.astro';
import StickyActionBar from '../components/StickyActionBar.astro';
import Divider from '../components/Divider.astro';
import ScrollMoment from '../components/ScrollMoment.astro';
import FloatingCTA from '../components/FloatingCTA.astro';
import Marquee from '../components/Marquee.astro';
import BeforeAfter from '../components/BeforeAfter.astro';
import Differentiator from '../components/Differentiator.astro';
import Team from '../components/Team.astro';
import Products from '../components/Products.astro';
import CTASection from '../components/CTASection.astro';
import BookShowcase from '../components/BookShowcase.astro';
import AuthorBio from '../components/AuthorBio.astro';

import { resolveNavLabels, resolveCta, resolveHeroCta } from '../lib/section-registry';

import contact from '../data/contact.json';
import location from '../data/location.json';
import testimonials from '../data/testimonials.json';
import theme from '../data/theme.json';

interface SectionEntry {
  id: string;
  variant?: string | number;
  component?: string;
}

const hasReviews = testimonials?.items?.length > 0;

// Component lookup by name string
const componentMap: Record<string, any> = {
  Hero, ServiceCards, PhotoGallery, ProjectGallery,
  TrustBar, TrustStats, ProcessSteps, MenuSection,
  Reviews, FAQ, QuoteForm, OrderVisit, AboutMap,
  HoursDisplay, BeforeAfter, Differentiator, Marquee,
  Team, Products, CTASection, BookShowcase, AuthorBio,
};

// Default component for each section ID
const defaultComponentMap: Record<string, string> = {
  hero: 'Hero', trust: 'TrustBar', services: 'ServiceCards',
  projects: 'ProjectGallery', process: 'ProcessSteps',
  gallery: 'PhotoGallery', menu: 'MenuSection', reviews: 'Reviews',
  faq: 'FAQ', contact: 'QuoteForm', about: 'AboutMap',
  hours: 'HoursDisplay', beforeAfter: 'BeforeAfter',
  differentiator: 'Differentiator', marquee: 'Marquee',
  team: 'Team', products: 'Products', cta: 'CTASection',
  book: 'BookShowcase',
};

// Variant overrides (e.g., trust:stats → TrustStats)
const variantOverrides: Record<string, Record<string, string>> = {
  trust: { stats: 'TrustStats' },
  contact: { 'order-visit': 'OrderVisit' },
  about: { 'author-bio': 'AuthorBio' },
};

function resolveComponent(entry: SectionEntry): any {
  // Explicit component override from theme data
  if (entry.component && componentMap[entry.component]) {
    return componentMap[entry.component];
  }
  // Variant-based override
  if (entry.variant !== undefined) {
    const overrides = variantOverrides[entry.id];
    if (overrides && String(entry.variant) in overrides) {
      return componentMap[overrides[String(entry.variant)]];
    }
  }
  // Default
  const name = defaultComponentMap[entry.id];
  return name ? componentMap[name] : null;
}

// Resolve sections from theme data
function resolveSections(themeData: any): SectionEntry[] {
  if (themeData.sections?.length > 0) return themeData.sections;
  const order = themeData.sectionOrder?.length > 0
    ? themeData.sectionOrder
    : ['hero', 'trust', 'services', 'projects', 'process', 'reviews', 'faq', 'contact', 'about'];
  return order.map((id: string) => ({ id }));
}

const sections = resolveSections(theme);

// Nav, CTA, and hero CTA — all data-driven from theme.json
const themeNav = (theme as any).nav || {};
const themeCta = (theme as any).cta || {};
const themeHeroCta = (theme as any).heroCta || {};
const themeActionBar = (theme as any).actionBar || {};

const sectionLabels = resolveNavLabels(themeNav.labels);
const cta = resolveCta(themeCta);
const heroCta = resolveHeroCta(themeHeroCta);

const navLinks = sections
  .filter(s => sectionLabels[s.id] && s.id !== 'hero')
  .filter(s => s.id !== 'reviews' || hasReviews)
  .map(s => ({ href: `#${s.id}`, text: sectionLabels[s.id] }));

// Load SVG icons for action bar
const actionIcons = import.meta.glob('/src/assets/svgs/icons/*.svg', { query: '?raw', import: 'default', eager: true });
function actionIcon(name: string): string {
  return (actionIcons[`/src/assets/svgs/icons/${name}.svg`] as string) || '';
}

// Visual depth: dark section and dividers
const layout = (theme as any).layout || {};
const depth = layout.depth || '';
const darkSection = layout.darkSection || '';
const useEditorialDividers = depth === 'editorial';

// Action bar — data-driven with sensible defaults
const defaultActionBarLinks = [
  { href: `tel:${contact.phoneForTel || ''}`, icon: actionIcon('phone'), text: 'Call' },
  { href: location.mapLink || '#', icon: actionIcon('navigation'), text: 'Directions' },
  { href: cta.href, icon: actionIcon('mail'), text: cta.text },
];
const actionBarLinks = themeActionBar.links || defaultActionBarLinks;
const showActionBar = themeActionBar.hidden !== true;
---
<BaseLayout>
  <StickyHeader navLinks={navLinks} ctaText={cta.text} ctaHref={cta.href} />

  {sections.map((entry, i) => {
    const Component = resolveComponent(entry);
    if (!Component) return null;
    if (entry.id === 'reviews' && !hasReviews) return null;
    const isDark = darkSection && entry.id === darkSection;
    const nextEntry = sections[i + 1];
    const nextIsDark = nextEntry && darkSection && nextEntry.id === darkSection;

    const showDividerBefore = useEditorialDividers && isDark;
    const showDividerAfterHero = useEditorialDividers && entry.id === 'hero' && nextEntry;

    return (
      <>
        {showDividerAfterHero && <Divider to="var(--surface)" variant="gentle" />}
        {showDividerBefore && <Divider to="var(--text)" variant="wave" />}
        {isDark ? (
          <div data-section-mood="dark">
            {entry.id === 'hero'
              ? <Component heroCta={heroCta} variant={entry.variant} />
              : <Component variant={entry.variant} />}
          </div>
        ) : (
          entry.id === 'hero'
            ? <Component heroCta={heroCta} variant={entry.variant} />
            : <Component variant={entry.variant} />
        )}
        {isDark && useEditorialDividers && <Divider to="var(--background)" variant="curve" />}
        {entry.id === 'reviews' && <ScrollMoment />}
      </>
    );
  })}

  <Footer />
  <FloatingCTA />
  {showActionBar && <StickyActionBar links={actionBarLinks} />}
</BaseLayout>
